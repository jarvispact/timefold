{
  "name": "timefold",
  "version": "0.0.1",
  "description": "A blazingly fast, ecs powered game engine for the web",
  "type": "module",
  "workspaces": [
    "packages/ecs",
    "packages/math",
    "packages/webgpu",
    "packages/obj",
    "packages/gltf2",
    "packages/engine",
    "packages/examples"
  ],
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:run --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "publish-to-npm": "npm run build --workspaces --if-present && npm run publish-to-npm --workspaces --if-present"
  },
  "keywords": [
    "game",
    "engine",
    "ecs",
    "webgpu"
  ],
  "author": "jarvispact <jarvispact@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.3",
    "@webgpu/types": "^0.1.66"
  }
}
