{
  "name": "@timefold/examples",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:benchmarks": "sed 's/{example-folder}/benchmarks/g' index.html.template > index.html && vite --port 9093",
    "build:benchmarks": "sed 's/{example-folder}/benchmarks/g' index.html.template > index.html && vite build",

    "dev:playground": "sed 's/{example-folder}/playground/g' index.html.template > index.html && vite --port 9093",
    "build:playground": "sed 's/{example-folder}/playground/g' index.html.template > index.html && vite build",

    "dev:hello-ecs": "sed 's/{example-folder}/hello-ecs/g' index.html.template > index.html && vite --port 9093",
    "build:hello-ecs": "sed 's/{example-folder}/hello-ecs/g' index.html.template > index.html && vite build",

    "preview": "vite preview --port 9191"
  },
  "dependencies": {
    "@timefold/ecs": "*",
    "@timefold/math": "*",
    "@timefold/webgpu": "*",
    "@timefold/obj": "*",
    "@timefold/gltf2": "*",
    "@timefold/engine": "*"
  }
}
