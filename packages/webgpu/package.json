{
  "name": "@timefold/webgpu",
  "version": "0.0.5",
  "description": "webgpu utils for timefold",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "jarvispact <jarvispact@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:run": "tsc -p ./tsconfig.test.json --noEmit && vitest run",
    "test:unit:run": "tsc -p ./tsconfig.test.json --noEmit && vitest run --project unit",
    "test:browser:run": "tsc -p ./tsconfig.test.json --noEmit && vitest run --project browser",
    "build": "rm -rf ./dist *.tsbuildinfo && tsc -b",
    "publish-to-npm": "npm publish"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.0"
  }
}
